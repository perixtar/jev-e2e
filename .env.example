# Local alpha configuration.
# Set real values only in a git-ignored local .env or process environment.

# Prefer one OpenRouter credential for the optional planner and Jev.
# Basic Choice requests passed through /api/alpha/decisions.
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Optional interpreter for free-form cases. Values: on or off.
# Off accepts the documented explicit format or a saved specification.
JEV_E2E_PLANNER=on
# Optional strict-schema interpreter. Evaluated default; override if desired.
# OpenAI is an optional vendor; no separate OPENAI_API_KEY is required.
OPENROUTER_PLANNER_MODEL=openai/gpt-4.1-mini

# Test fixture credentials, when an authenticated case requires them.
# Models receive fixture references; the executor resolves the exact values.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_TEST_INVALID_PASSWORD=
