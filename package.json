{
  "name": "jev-e2e",
  "version": "0.1.0-alpha.1",
  "description": "Test websites and native mobile apps from natural-language cases with Jev and checked evidence.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "jev-e2e": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public",
    "examples",
    "docs/MOBILE.md",
    "MOBILE_TEST_RESULTS.md",
    "README.md",
    "CONTRIBUTING.md",
    "TEST_RESULTS.md",
    "TEST_PLAN.md",
    "TECHNICAL_PLAN.md",
    "UI_DESIGN.md",
    ".env.example",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node scripts/evaluate.mjs",
    "test:mobile": "npm run build && node scripts/evaluate-mobile.mjs",
    "test:mobile:language": "npm run build && node scripts/evaluate-mobile-language.mjs",
    "test:mobile:sdk": "npm run build && node test/mobile-live.mjs",
    "ui": "node dist/cli.js ui",
    "demo": "node dist/cli.js demo",
    "prepack": "npm run build"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perixtar/jev-e2e.git"
  },
  "bugs": {
    "url": "https://github.com/perixtar/jev-e2e/issues"
  },
  "homepage": "https://github.com/perixtar/jev-e2e#readme",
  "optionalDependencies": {
    "agent-device": "0.21.6"
  }
}
